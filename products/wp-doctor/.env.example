# Ejemplo documental: Wrangler usa bindings/vars y .dev.vars para secretos locales.
# No existe bypass local de Access. Sin estas claves el formulario permanece cerrado.
DATA_ENCRYPTION_KEY=
HASH_SECRET=
TURNSTILE_SECRET=
# Access y las claves públicas se configuran en Wrangler.
# Diagnóstico y entrega: nunca pegar estos valores en Git ni en el chat.
PAGESPEED_API_KEY=
# resend_email: clave de envío guardada como secreto del Worker público.
RESEND_API_KEY=
# Wompi: llaves exclusivas de servidor; no usar el enlace de anticipo de otro producto.
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
# n8n_pdf_whatsapp reutiliza Kapso dentro de n8n; no necesita Brevo/Meta aquí.
PROXY_ORIGIN_SECRET=
# Secreto exclusivo del controlador VPS; nunca se transmite al navegador del diagnóstico.
ISOLATED_RUNNER_SECRET=
# Activación solo después de configurar servicios y migraciones, con env distinto de preview.
