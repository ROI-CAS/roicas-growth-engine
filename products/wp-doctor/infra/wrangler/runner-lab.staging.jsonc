{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "wpdoctor-runner-lab-staging",
  "account_id": "65b9d77fd1f62e237dce8a2c6e5a8288",
  "main": "../../apps/runner-lab/worker.ts",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "services": [
    {
      "binding": "RUNNER",
      "service": "wpdoctor-browser-runner-staging",
      "entrypoint": "BrowserRunner",
    },
    {
      "binding": "ADMISSION",
      "service": "wpdoctor-runner-admission-staging",
      "entrypoint": "Admission",
    },
  ],
  "vars": { "LAB_EXPIRES_AT": "0" },
  "observability": { "enabled": false },
}
