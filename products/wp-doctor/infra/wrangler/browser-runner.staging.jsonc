{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "wpdoctor-browser-runner-staging",
  "account_id": "65b9d77fd1f62e237dce8a2c6e5a8288",
  "main": "../../apps/browser-runner/worker.ts",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "browser": { "binding": "BROWSER" },
  "services": [
    {
      "binding": "ADMISSION",
      "service": "wpdoctor-runner-admission-staging",
      "entrypoint": "Admission",
    },
  ],
  "vars": {
    "RUNNER_MODE": "laboratory",
    "RUNNER_APPROVED_HOSTS": "[\"doctor.roicas.com\"]",
  },
  "observability": { "enabled": false },
}
