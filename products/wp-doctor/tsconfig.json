{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "api/**/*.ts",
    "apps/**/*.ts",
    "packages/**/*.ts",
    "tests/**/*.ts",
    "*.ts",
    ".cache/runner-runtime.d.ts"
  ],
  "exclude": ["apps/public/client.ts", "apps/admin/client.ts"]
}
