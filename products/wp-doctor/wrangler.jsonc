{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Landing de preparación para el Worker conectado a GitHub.
  // La captación completa usa las configuraciones por entorno de infra/wrangler.
  "name": "webexpress-wp-doctor",
  "account_id": "65b9d77fd1f62e237dce8a2c6e5a8288",
  "main": "apps/public/worker.ts",
  "compatibility_date": "2026-10-15",
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": true,
  "triggers": { "crons": ["* * * * *"] },
  "assets": {
    "directory": "./dist/site",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wpdoctor-production",
      "database_id": "d795e6fd-29fe-4b3c-bf0a-a4d4e823f143",
      "migrations_dir": "./infra/migrations",
    },
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "PUBLIC_DIAGNOSIS_ENABLED": "true",
    "TRUSTED_PROXY_REQUIRED": "true",
    "LEGAL_APPROVED": "true",
    "RETENTION_ENABLED": "true",
    "WOMPI_ENABLED": "false",
    "WOMPI_ENVIRONMENT": "prod",
    "BUSINESS_NAME": "César Silva · Roicas — Marketing y Automatizaciones",
    "BUSINESS_EMAIL": "hello@roicas.com",
    "PRIVACY_CONTACT": "hello@roicas.com",
    "WHATSAPP_PUBLIC_NUMBER": "573114565403",
    "APP_BASE_URL": "https://doctor.roicas.com",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFX9UHYovVh9UAsA",
    "DIAGNOSIS_ENGINE": "pagespeed",
    "BROWSER_DIAGNOSTICS_MODE": "isolated",
    "BROWSER_SECURITY_APPROVED": "true",
    "ISOLATED_RUNNER_URL": "https://runner.srv1162733.hstgr.cloud",
    "DIAGNOSTIC_DELIVERY_ENABLED": "true",
    "DELIVERY_MODE": "resend_email",
    "EMAIL_FROM": "wpdoctor@roicas.com",
    "N8N_DISPATCH_WEBHOOK_URL": "https://n8n.srv1162733.hstgr.cloud/webhook/wpdoctor-delivery-v1",
    "N8N_SEND_ENABLED": "false",
    "N8N_DOCUMENT_TEMPLATE_NAME": "",
    "N8N_TEMPLATE_LANGUAGE": "es",
  },
  "observability": {
    "enabled": false,
  },
}
