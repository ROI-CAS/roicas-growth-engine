{
  "name": "webexpress-wp-doctor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && wrangler dev --config infra/wrangler/public.toml",
    "typecheck": "wrangler types .cache/runner-runtime.d.ts --config infra/wrangler/browser-runner.staging.jsonc --include-env=false && tsc --noEmit && tsc --noEmit -p tsconfig.client.json",
    "lint": "eslint .",
    "format": "prettier --write --ignore-path .gitignore apps packages scripts tests infra/wrangler package.json tsconfig.json vitest.config.ts playwright.config.ts eslint.config.mjs",
    "test": "vitest run",
    "test:runner": "vitest run tests/runner-policy.test.ts tests/runner-admission.test.ts && vitest run --config vitest.runner.config.ts",
    "test:runner:remote": "node scripts/test-runner-remote.mjs",
    "test:e2e": "npm run build && playwright test",
    "demo:fixtures": "npm run build && tsx tests/fixture-server.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "db:local": "wrangler d1 migrations apply DB --local --config infra/wrangler/public.toml",
    "deploy:staging": "node scripts/deploy.mjs staging",
    "deploy:production": "node scripts/deploy.mjs production"
  },
  "engines": {
    "node": "24.x"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261012.1": true
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7",
    "@cloudflare/playwright": "1.3.6",
    "ipaddr.js": "2.5.0",
    "jose": "6.2.12",
    "libphonenumber-js": "1.13.15",
    "pdf-lib": "1.17.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/workers-types": "5.20261015.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "miniflare": "5.20261012.0-beta",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "4.1.12",
    "wrangler": "4.151.0"
  }
}
