{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/wompi/webhook", "destination": "/api/web-express?action=wompi" }
  ],
  "redirects": [
    { "source": "/brief-tienda-online", "destination": "/cotizar-tienda-online", "permanent": true }
  ]
}
